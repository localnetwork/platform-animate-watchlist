generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WatchStatus {
  PLANNED
  WATCHING
  COMPLETED
  DROPPED
}

enum AnimeAiredStatus {
  NOT_YET_RELEASED
  AIRING
  FINISHED
  HIATUS
  CANCELLED
}

model User {
  id            String            @id @default(uuid())
  email         String            @unique
  password      String
  name          String?
  username      String?           @unique
  bio           String?
  avatarUrl     String?
  socialLinks   Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  animeEntries  AnimeEntry[]
  animeAuthors  AnimeAuthor[]
  animeRatings  AnimeRating[]
  animeStatuses UserAnimeStatus[]
  animeFavorites AnimeFavorite[]
  roleLinks     UserRole[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  userLinks   UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("permissions")
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("roles_permissions")
}

model AnimeEntry {
  id            String             @id @default(uuid())
  slug          String             @unique
  title         String
  description   String
  coverImageUrl String
  airedFrom     DateTime?
  airedTo       DateTime?
  airedStatus   AnimeAiredStatus   @default(NOT_YET_RELEASED)
  viewCount     Int                @default(0)
  notes         String?
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes      AnimeEpisode[]
  authorLinks   AnimeEntryAuthor[]
  ratings       AnimeRating[]
  genreLinks    AnimeEntryGenre[]
  userStatuses  UserAnimeStatus[]
  favorites     AnimeFavorite[]
  typeId        String?
  type          AnimeType?         @relation(fields: [typeId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId])
  @@index([airedStatus])
  @@index([viewCount])
  @@index([typeId])
  @@map("anime_entries")
}

model UserAnimeStatus {
  id           String      @id @default(uuid())
  userId       String
  animeEntryId String
  status       WatchStatus @default(PLANNED)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  animeEntry   AnimeEntry  @relation(fields: [animeEntryId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, animeEntryId])
  @@index([animeEntryId])
  @@index([status])
  @@map("user_anime_statuses")
}

model AnimeFavorite {
  id           String     @id @default(uuid())
  userId       String
  animeEntryId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  animeEntry   AnimeEntry @relation(fields: [animeEntryId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, animeEntryId])
  @@index([animeEntryId])
  @@map("anime_favorites")
}

model Genre {
  id         String            @id @default(uuid())
  name       String            @unique
  animeLinks AnimeEntryGenre[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@map("genres")
}

model AnimeType {
  id           String       @id @default(uuid())
  name         String       @unique
  animeEntries AnimeEntry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("anime_types")
}

model AnimeEntryGenre {
  animeEntryId String
  genreId      String
  animeEntry   AnimeEntry @relation(fields: [animeEntryId], references: [id], onDelete: Cascade)
  genre        Genre      @relation(fields: [genreId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([animeEntryId, genreId])
  @@index([genreId])
  @@map("anime_entry_genres")
}

model AnimeRating {
  id           String     @id @default(uuid())
  animeEntryId String
  userId       String
  value        Int
  animeEntry   AnimeEntry @relation(fields: [animeEntryId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([animeEntryId, userId])
  @@index([userId])
  @@index([animeEntryId])
  @@map("anime_ratings")
}

model AnimeEpisode {
  id              String     @id @default(uuid())
  animeEntryId    String
  episodeNumber   Int
  title           String?
  description     String?
  durationMinutes Int?
  airDate         DateTime?
  videoUrl        String?
  animeEntry      AnimeEntry @relation(fields: [animeEntryId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([animeEntryId, episodeNumber])
  @@index([animeEntryId])
  @@map("anime_episodes")
}

model AnimeAuthor {
  id         String             @id @default(uuid())
  name       String
  bio        String?
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  animeLinks AnimeEntryAuthor[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("anime_authors")
}

model AnimeEntryAuthor {
  animeEntryId String
  authorId     String
  role         String?
  animeEntry   AnimeEntry  @relation(fields: [animeEntryId], references: [id], onDelete: Cascade)
  author       AnimeAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@id([animeEntryId, authorId])
  @@index([authorId])
  @@map("anime_entry_authors")
}
